{
  "name": "Notificaci\u00f3n Fichaje Salida (15:00)",
  "description": "Env\u00eda recordatorio de fichaje de salida a las 15:00 (lunes a viernes, excluyendo festivos)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 13 * * 1-5",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificaci_n_fichaje_salida_15_00",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendClockInNotifications",
            "args": {
              "notificationType": "afternoon"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendClockInNotifications"
  }
}